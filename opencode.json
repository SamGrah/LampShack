{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "permission": {
    "edit": {
      "*": "allow",
      "**/src/styles/css/**": "deny",
      "src/styles/css/**": "deny"
    },
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "git push*": "ask",
      "git reset*": "ask",
      "git checkout*": "ask",
      "netlify *": "ask",
      "npx netlify*": "ask"
    }
  }
}
