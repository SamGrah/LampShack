---
import { ClientRouter, fade } from "astro:transitions";
import "../styles/css/core-styles.css";
import "../styles/css/dark.css";

import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";

const SITE = "https://www.thelampshack.com";
const DEFAULT_TITLE = "Lamp Shack | Lamp & Lighting Repair in Waterford, MI";
const DEFAULT_DESCRIPTION =
  "Experienced lamp and lighting repair service in Waterford, MI offering personalized and meticulous restoration. Call ahead before visiting.";

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  path = "/",
} = Astro.props;

// Normalize the canonical/OG URL for this page.
const canonical = new URL(path, SITE).href;
const ogImage = new URL("/assets/images/LampShackLogo.svg", SITE).href;

// LocalBusiness structured data — rendered on every page so the business
// details are always discoverable by search engines and the local pack.
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "@id": `${SITE}/#business`,
  name: "The Lamp Shack",
  description: DEFAULT_DESCRIPTION,
  url: SITE,
  telephone: "+1-248-672-2059",
  image: ogImage,
  priceRange: "$$",
  address: {
    "@type": "PostalAddress",
    streetAddress: "618 W Preda Drive",
    addressLocality: "Waterford",
    addressRegion: "MI",
    postalCode: "48328",
    addressCountry: "US",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 42.64628168828236,
    longitude: -83.38147643241459,
  },
  areaServed: {
    "@type": "City",
    name: "Waterford, MI",
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "10:00",
      closes: "16:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: "Saturday",
      opens: "10:00",
      closes: "15:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: "Sunday",
      opens: "11:00",
      closes: "15:00",
    },
  ],
};
---

<!DOCTYPE html>
<html lang="en">

  <head>
    <ClientRouter />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-EB6NHTX4M3"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());

      gtag('config', 'G-EB6NHTX4M3');

      (function (c, l, a, r, i, t, y) {
        c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments) };
        t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i;
        y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
      })(window, document, "clarity", "script", "sgv2ltdbah");
    </script>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="canonical" href={canonical}>

    <meta name="description" content={description}>

    <!--Social Media Display-->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />

    <!--Favicons-->
    <link rel="icon" type="image/svg+xml" href="/LampWhite.svg">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#ffffff">

    <!-- Preload critical fonts to avoid a flash of invisible text -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/roboto-v29-latin-regular.woff2" crossorigin>
    <link rel="preload" as="font" type="font/woff2" href="/fonts/roboto-v29-latin-700.woff2" crossorigin>
    <link rel="preload" as="font" type="font/woff2" href="/fonts/roboto-v29-latin-900.woff2" crossorigin>

    <!-- LocalBusiness structured data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(localBusinessSchema)} />

    <title>{title}</title>
  </head>

  <body class="cs-open" transition:animate="fade">
    <!--Screen reader skip main nav-->
    <a class="skip" aria-label="skip to main content" href="#main">Click To Skip To Main Content</a>
    <NavBar />
    <slot />
    <Footer />
  </body>

</html>
