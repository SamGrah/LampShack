---
import { Image } from "astro:assets"
import WorkbenchImage from "../assets/images/workbench.jpeg"
import "../styles/css/contact.css";
import BasePage from "../components/BasePage.astro";
---

<BasePage
  title="Contact | Call Ahead — The Lamp Shack, Waterford MI"
  description="Contact The Lamp Shack in Waterford, MI. Call (248) 672-2059 before visiting. 618 W Preda Drive. Hours: weekdays 10am–4pm, Saturday 10am–3pm, Sunday 11am–3pm."
  path="/contact"
>
  <main id="main">
    <!-- ============================================ -->
    <!--                   Banner                     -->
    <!-- ============================================ -->

    <div id="banner-712">
      <div class="cs-container">
        <span class="cs-int-title">Contact</span>
      </div>
      <!--Background Image-->
      <picture class="cs-background">
        <Image class="cs-background" src={WorkbenchImage} alt="" width="1280" height="568" decoding="async" loading="eager" aria-hidden="true" />
      </picture>
    </div>

    <!-- ============================================ -->
    <!--                Contact Info                  -->
    <!-- ============================================ -->

    <section id="cs-contact-265">
      <div class="cs-container">
        <div class="cs-left-section">
          <div class="cs-content">
            <span class="cs-topper">Before You Visit</span>
            <h2 class="cs-title">Please Call Ahead</h2>
            <p class="cs-text">
              <strong>Reach me by phone before stopping in.</strong> I'm retired
              and may be out &amp; about — an unexpected visit might catch me
              away from the shop.
            </p>
          </div>

          <div class="cs-info-card">
            <div class="cs-info-block">
              <span class="cs-header">Available Hours</span>
              <dl class="cs-hours">
                <div class="cs-hours-row">
                  <dt>Weekdays</dt>
                  <dd>10am &ndash; 4pm</dd>
                </div>
                <div class="cs-hours-row">
                  <dt>Saturday</dt>
                  <dd>10am &ndash; 3pm</dd>
                </div>
                <div class="cs-hours-row">
                  <dt>Sunday</dt>
                  <dd>11am &ndash; 3pm</dd>
                </div>
              </dl>
            </div>

            <div class="cs-info-block">
              <span class="cs-header">Phone</span>
              <a class="cs-link" href="tel:248-672-2059">(248) 672-2059</a>
            </div>

            <div class="cs-info-block">
              <span class="cs-header">Address</span>
              <a class="cs-link" href="https://maps.app.goo.gl/yPGWi9MHSPJq6m4A7">
                618 W Preda Drive,
                <span class="cs-block">Waterford, MI 48328</span>
              </a>
            </div>
          </div>
        </div>

        <div class="cs-right-section">
          <iframe
            class="cs-map"
            title="Map to The Lamp Shack in Waterford, MI"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3799.859613685037!2d-83.38147643241459!3d42.64628168828236!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8824bc4d4eaa03c3%3A0x8bee045ac1602c00!2sLamp%20Shack%20(Call%201st)!5e0!3m2!1sen!2sus!4v1713045631344!5m2!1sen!2sus"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </section>

  </main>
</BasePage>
