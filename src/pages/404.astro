---
import BasePage from "../components/BasePage.astro";
---

<BasePage
  title="Page Not Found | The Lamp Shack"
  description="The page you were looking for could not be found. Return home or call The Lamp Shack in Waterford, MI."
  path="/404"
>
  <main id="main">
    <section class="notfound">
      <div class="cs-container">
        <h1 class="cs-title">Page Not Found</h1>
        <p class="cs-text">
          Sorry &mdash; the page you were looking for doesn't exist. It may have
          moved, or the link may be out of date.
        </p>
        <div class="notfound-actions">
          <a href="/" class="cs-button-solid">Back to Home</a>
        </div>
        <p class="cs-text">
          Need a lamp repaired? Call
          <a href="tel:248-672-2059">(248) 672-2059</a>.
        </p>
      </div>
    </section>
  </main>
</BasePage>

<style>
  .notfound {
    padding: var(--sectionPadding);
  }

  .notfound .cs-container {
    width: 100%;
    max-width: 46rem;
    margin: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .notfound-actions {
    margin: 0.5rem 0;
  }

  .notfound .cs-text a {
    color: var(--primary);
    font-weight: 700;
    text-decoration: underline;
  }
</style>
