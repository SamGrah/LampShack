---
import { Image } from "astro:assets"
import ToolsImage from "../assets/images/tools.jpeg"
import Example1Image from "../assets/images/example1.jpeg"
import Example2Image from "../assets/images/example2.jpeg"
import Example3Image from "../assets/images/example3.jpeg"
import Example4Image from "../assets/images/example4.jpeg"
import Example5Image from "../assets/images/example5.jpeg"
import Example6Image from "../assets/images/example6.jpeg"
import Example7Image from "../assets/images/example7.jpeg"
import Example8Image from "../assets/images/example8.jpeg"
import Example9Image from "../assets/images/example9.jpeg"
import "../styles/css/portfolio.css";
import BasePage from "../components/BasePage.astro";

// Gallery items, laid out into three columns. `full` is a higher-resolution
// variant Astro generates from the same source for the expanded view.
const gallery = [
  { img: Example1Image, alt: "fixture with four hanging lanterns" },
  { img: Example2Image, alt: "two lamps with circular glass bodies" },
  { img: Example3Image, alt: "tripod base supporting shaded lamp" },
  { img: Example4Image, alt: "ornate table top lamp with metalwork decorations" },
  { img: Example5Image, alt: "antique handlamp with metalic housing" },
  { img: Example6Image, alt: "six post hanging lamp with gold body" },
  { img: Example7Image, alt: "two tier chandelier with hanging crystals" },
  { img: Example8Image, alt: "candelabra style table top lamp" },
  { img: Example9Image, alt: "unfinished antique metalic and ivory lamp base with metalic legs" },
];

// Column assignment preserves the original 3x3 layout (row-major).
const columns = [
  [gallery[0], gallery[3], gallery[6]],
  [gallery[1], gallery[4], gallery[7]],
  [gallery[2], gallery[5], gallery[8]],
];
const pictureHeights = [
  ["567", "492", "625"],
  ["629", "517", "452"],
  ["512", "629", "629"],
];
---

<BasePage>
  <main id="main">
    <!-- ============================================ -->
    <!--                   Banner                     -->
    <!-- ============================================ -->

    <div id="banner-712">
      <div class="cs-container">
        <span class="cs-int-title">Portfolio</span>
      </div>
      <!--Background Image-->
      <picture class="cs-background">
        <Image class="cs-background" src={ToolsImage} alt="tools" width="1280" height="568" decoding="async" loading="eager" aria-hidden="true" />
      </picture>
    </div>

    <!-- ============================================ -->
    <!--                   Gallery                    -->
    <!-- ============================================ -->

    <section id="gallery-48">
      <div class="cs-container">
        <div class="cs-content">
          <span class="cs-topper">Samples of</span>
          <h2 class="cs-title">Finished Work</h2>
        </div>
        <div class="cs-image-group">
          {columns.map((col, c) => (
            <div class={`cs-row cs-row-${c + 1}`}>
              {col.map((item, r) => (
                <button
                  type="button"
                  class={`cs-picture cs-picture-${r + 1} cs-thumb`}
                  aria-label={`Expand image: ${item.alt}`}
                >
                  <Image
                    src={item.img}
                    alt={item.alt}
                    widths={[420, 840]}
                    sizes="(max-width: 48rem) 33vw, 420px"
                    height={Number(pictureHeights[c][r])}
                    width={420}
                    decoding="async"
                    loading="eager"
                    data-full={item.img.src}
                  />
                </button>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <!-- ============================================ -->
  <!--              Lightbox overlay                -->
  <!-- ============================================ -->
  <div id="cs-lightbox" class="cs-lightbox" aria-hidden="true">
    <div class="cs-lightbox-backdrop"></div>
    <figure class="cs-lightbox-stage">
      <img class="cs-lightbox-img" alt="" />
    </figure>
    <button type="button" class="cs-lightbox-close" aria-label="Close image">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <script>
    // FLIP expandable gallery: the clicked thumbnail morphs to a centered
    // full-size image over a backdrop, can be zoomed, and animates back on
    // close. No layout artifacts because we animate a single overlay image
    // between measured rectangles (First/Last/Invert/Play).
    (() => {
      const lb = document.getElementById("cs-lightbox");
      if (!lb) return;
      const lightbox = lb;
      const stage = lightbox.querySelector(".cs-lightbox-stage") as HTMLElement;
      const img = lightbox.querySelector(".cs-lightbox-img") as HTMLImageElement;
      const closeBtn = lightbox.querySelector(".cs-lightbox-close") as HTMLElement;
      const thumbs = Array.from(
        document.querySelectorAll<HTMLButtonElement>("#gallery-48 .cs-thumb")
      );

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const OPEN_MS = 360;
      const EASE = "cubic-bezier(0.22, 0.61, 0.36, 1)";

      let activeThumb: HTMLButtonElement | null = null;
      let isOpen = false;
      let isZoomed = false;
      let isAnimating = false;

      const thumbImg = (t: HTMLButtonElement) => t.querySelector("img");

      function setStageRectToThumb(t: HTMLButtonElement) {
        const r = (thumbImg(t) as HTMLElement).getBoundingClientRect();
        stage.style.top = `${r.top}px`;
        stage.style.left = `${r.left}px`;
        stage.style.width = `${r.width}px`;
        stage.style.height = `${r.height}px`;
      }

      // The centered target rectangle the image expands to.
      function setStageRectToTarget() {
        const margin = Math.min(window.innerWidth, window.innerHeight) * 0.06;
        const maxW = window.innerWidth - margin * 2;
        const maxH = window.innerHeight - margin * 2;
        const natW = img.naturalWidth || maxW;
        const natH = img.naturalHeight || maxH;
        const scale = Math.min(maxW / natW, maxH / natH, 1);
        const w = natW * scale;
        const h = natH * scale;
        stage.style.width = `${w}px`;
        stage.style.height = `${h}px`;
        stage.style.top = `${(window.innerHeight - h) / 2}px`;
        stage.style.left = `${(window.innerWidth - w) / 2}px`;
      }

      function lockScroll(lock: boolean) {
        document.documentElement.style.overflow = lock ? "hidden" : "";
      }

      async function open(t: HTMLButtonElement) {
        if (isAnimating || isOpen) return;
        activeThumb = t;
        const source = thumbImg(t) as HTMLImageElement;
        const full = source.getAttribute("data-full") || source.currentSrc || source.src;

        // Load the full image first so we know its natural size.
        img.src = full;
        img.alt = source.alt;
        if (!img.complete) {
          await new Promise((res) => {
            img.onload = res;
            img.onerror = res;
          });
        }

        isOpen = true;
        lightbox.classList.add("is-visible");
        lightbox.setAttribute("aria-hidden", "false");
        lockScroll(true);

        if (reduceMotion.matches) {
          setStageRectToTarget();
          lightbox.classList.add("is-open");
          closeBtn.focus();
          return;
        }

        // FLIP: start at the thumbnail rect, transition to target rect.
        isAnimating = true;
        setStageRectToThumb(t);
        stage.style.transition = "none";
        // force reflow so the start rect is committed
        void stage.offsetWidth;
        stage.style.transition = `top ${OPEN_MS}ms ${EASE}, left ${OPEN_MS}ms ${EASE}, width ${OPEN_MS}ms ${EASE}, height ${OPEN_MS}ms ${EASE}`;
        lightbox.classList.add("is-open");
        requestAnimationFrame(() => setStageRectToTarget());
        window.setTimeout(() => {
          isAnimating = false;
          closeBtn.focus();
        }, OPEN_MS);
      }

      function close() {
        if (isAnimating || !isOpen) return;
        if (isZoomed) toggleZoom(false);

        const finish = () => {
          isOpen = false;
          isAnimating = false;
          lightbox.classList.remove("is-visible", "is-open");
          lightbox.setAttribute("aria-hidden", "true");
          stage.style.transition = "";
          img.src = "";
          lockScroll(false);
          // Restore focus to the thumbnail for accessibility, but mark it so
          // CSS suppresses the focus-visible outline on this programmatic
          // (mouse/Esc-driven) return. A genuine keyboard Tab onto the thumb
          // later still shows the outline. The marker clears on blur.
          if (activeThumb) {
            const t = activeThumb;
            t.classList.add("is-returning");
            t.addEventListener(
              "blur",
              () => t.classList.remove("is-returning"),
              { once: true }
            );
            t.focus({ preventScroll: true });
          }
          activeThumb = null;
        };

        if (reduceMotion.matches || !activeThumb) {
          finish();
          return;
        }

        isAnimating = true;
        lightbox.classList.remove("is-open");
        stage.style.transition = `top ${OPEN_MS}ms ${EASE}, left ${OPEN_MS}ms ${EASE}, width ${OPEN_MS}ms ${EASE}, height ${OPEN_MS}ms ${EASE}`;
        setStageRectToThumb(activeThumb);
        window.setTimeout(finish, OPEN_MS);
      }

      function toggleZoom(force?: boolean) {
        isZoomed = typeof force === "boolean" ? force : !isZoomed;
        lightbox.classList.toggle("is-zoomed", isZoomed);
      }

      // Thumbnails open the lightbox.
      thumbs.forEach((t) => t.addEventListener("click", () => open(t)));

      // Click the expanded image to toggle zoom; click backdrop/close to exit.
      img.addEventListener("click", (e) => {
        e.stopPropagation();
        if (!isAnimating) toggleZoom();
      });
      closeBtn.addEventListener("click", close);
      lightbox.addEventListener("click", (e) => {
        if (e.target === closeBtn || (e.target as HTMLElement).closest(".cs-lightbox-close")) return;
        if (e.target !== img) close();
      });

      // Keyboard: Esc closes.
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && isOpen) close();
      });

      // Keep the expanded image centered on resize.
      window.addEventListener("resize", () => {
        if (isOpen && !isAnimating && !isZoomed) {
          stage.style.transition = "none";
          setStageRectToTarget();
        }
      });
    })();
  </script>
</BasePage>
